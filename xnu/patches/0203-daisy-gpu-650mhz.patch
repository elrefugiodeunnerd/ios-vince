diff --git a/bsd/dev/daisy_gpu_clock.h b/bsd/dev/daisy_gpu_clock.h
new file mode 100644
index 0000000..8c651e3
--- /dev/null
+++ b/bsd/dev/daisy_gpu_clock.h
@@ -0,0 +1,165 @@
+/*
+ * MSM8953/Daisy only, included by vince_adreno.c after its MMIO helpers.
+ * daisygpu_mhz=650, adreno=11 and daisygpu_test=1 select this startup path.
+ *
+ * Xiaomi_Kernel_OpenSource 6421aa5cdc56e9ef7c6329e0a05164503e1513ef:
+ * clock-gcc-8953.c (GPLL3, 1-2 GHz VCO, /2, GFX source 2/div1);
+ * clock-alpha-pll.c (1500 MHz calibration, dynamic slew, 40-bit alpha);
+ * msm8953-regulator.dtsi (CX TURBO, BHS, mem-acc corner 2).
+ * This is not Cobalt GPUCC/Fabia and not Hakios's A642L/GMU/RPMh path.
+ *
+ * Run before CP startup. The proven LK handoff already selects BHS with
+ * its hardware acknowledgement set (control 0x80000038, status 0x3).
+ * Require that state rather than transitioning an unobserved live LDO.
+ * Keep the acknowledged CX vote until reboot, including on clock failure.
+ */
+extern int daisy_gpu_cx_turbo(void);
+
+#define DG_PLL_MODE       0x22000u
+#define DG_PLL_L          0x22004u
+#define DG_PLL_ALPHA      0x22008u
+#define DG_PLL_ALPHA_HI   0x2200cu
+#define DG_PLL_USER       0x22010u
+#define DG_PLL_USER_HI    0x22014u
+#define DG_PLL_CONFIG     0x22018u
+#define DG_PLL_TEST       0x2201cu
+#define DG_PLL_TEST_HI    0x22020u
+#define DG_LOCK           (1u << 31)
+#define DG_UPDATE         (1u << 22)
+#define DG_MEM_ACC_PA     0x01944000u
+#define DG_MEM_ACC_OFF    0x15cu
+#define DG_RCG_MASK       0x71fu
+#define DG_RCG_650        0x201u
+
+static bool
+dg_wait(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t value)
+{
+	for (unsigned i = 0; i < 1000; i++) {
+		if ((reg_read(base, off) & mask) == value) { return true; }
+		delay(1);
+	}
+	printf("DAISY GPU CLOCK: timeout off=%#x value=%#x mask=%#x want=%#x\n",
+	    off, reg_read(base, off), mask, value);
+	return false;
+}
+
+static void
+dg_pll_rate(uint32_t hz)
+{
+	/* Stock round_rate_up uses 32 fractional bits, shifted into 40-bit HW. */
+	uint64_t alpha = (((uint64_t)(hz % 19200000u) << 32) + 19199999u) / 19200000u;
+	alpha <<= 8;
+	reg_write(gcc_va, DG_PLL_L, hz / 19200000u);
+	reg_write(gcc_va, DG_PLL_ALPHA, (uint32_t)alpha);
+	reg_write(gcc_va, DG_PLL_ALPHA_HI, (uint32_t)(alpha >> 32));
+}
+
+static bool
+dg_pll_matches(void)
+{
+	/* 1300 MHz rounded up: L=67, alpha=0xb555555600, post-divider /2. */
+	return (reg_read(gcc_va, DG_PLL_MODE) & (DG_LOCK | DG_UPDATE | 7u)) == (DG_LOCK | 7u) &&
+	       reg_read(gcc_va, DG_PLL_L) == 67u &&
+	       reg_read(gcc_va, DG_PLL_ALPHA) == 0x55555600u &&
+	       reg_read(gcc_va, DG_PLL_ALPHA_HI) == 0xb5u &&
+	       (reg_read(gcc_va, DG_PLL_USER) & 0x01300f0fu) == 0x01000101u;
+}
+
+static bool
+dg_pll_start(void)
+{
+	uint32_t mode = reg_read(gcc_va, DG_PLL_MODE);
+	if (dg_pll_matches()) { return true; }
+	/* Never reprogram an enabled, transitioning or firmware-owned PLL. */
+	if (mode & (DG_LOCK | (1u << 30) | DG_UPDATE | (1u << 20) | 7u)) {
+		printf("DAISY GPU CLOCK: GPLL3 handoff not idle/1300 MHz (%#x)\n", mode);
+		return false;
+	}
+	reg_write(gcc_va, DG_PLL_CONFIG, 0x4001055bu);
+	uint32_t user = reg_read(gcc_va, DG_PLL_USER);
+	user = (user & ~0x01300f0fu) | 0x01000101u; /* VCO0, alpha, /2, main */
+	reg_write(gcc_va, DG_PLL_USER, user);
+	reg_write(gcc_va, DG_PLL_USER_HI, reg_read(gcc_va, DG_PLL_USER_HI) & ~(1u << 11));
+	reg_write(gcc_va, DG_PLL_TEST, 0);
+	reg_write(gcc_va, DG_PLL_TEST_HI, 0);
+	dg_pll_rate(1500000000u);
+	reg_write(gcc_va, DG_PLL_MODE, mode | 2u); /* bypass off */
+	delay(5);
+	reg_write(gcc_va, DG_PLL_MODE, mode | 6u); /* reset released, output off */
+	if (!dg_wait(gcc_va, DG_PLL_MODE, DG_LOCK, DG_LOCK)) { goto fail; }
+	dg_pll_rate(1300000000u);
+	reg_write(gcc_va, DG_PLL_MODE, reg_read(gcc_va, DG_PLL_MODE) | DG_UPDATE);
+	if (!dg_wait(gcc_va, DG_PLL_MODE, DG_UPDATE, 0)) { goto fail; }
+	delay(1); /* >=570 ns between update completion and LOCK sampling */
+	if (!dg_wait(gcc_va, DG_PLL_MODE, DG_LOCK, DG_LOCK)) { goto fail; }
+	reg_write(gcc_va, DG_PLL_MODE, reg_read(gcc_va, DG_PLL_MODE) | 1u);
+	if (dg_pll_matches()) { return true; }
+fail:
+	/* GFX is still on GPLL0. This PLL was off when we took ownership. */
+	reg_write(gcc_va, DG_PLL_MODE, reg_read(gcc_va, DG_PLL_MODE) & ~1u);
+	delay(1);
+	reg_write(gcc_va, DG_PLL_MODE, mode & ~7u);
+	return false;
+}
+
+static bool
+dg_rcg_set(uint32_t cfg)
+{
+	reg_write(gcc_va, GCC_GFX3D_CFG_RCGR, cfg);
+	reg_write(gcc_va, GCC_GFX3D_CMD_RCGR, reg_read(gcc_va, GCC_GFX3D_CMD_RCGR) | 1u);
+	return dg_wait(gcc_va, GCC_GFX3D_CMD_RCGR, 1u, 0) &&
+	       reg_read(gcc_va, GCC_GFX3D_CFG_RCGR) == cfg &&
+	       dg_wait(gcc_va, GCC_GFX3D_CMD_RCGR, 1u << 31, 0) &&
+	       dg_wait(gcc_va, GCC_OXILI_GFX3D_CBCR, 1u << 31, 0);
+}
+
+static bool
+daisy_gpu_clock_start(void)
+{
+	uint32_t mhz = 0, test = 0;
+	if (!PE_parse_boot_argn("daisygpu_mhz", &mhz, sizeof(mhz)) || !mhz) { return true; }
+	PE_parse_boot_argn("daisygpu_test", &test, sizeof(test));
+	if (mhz != 650 || last_step != 11 || skip_steps || !test) {
+		printf("DAISY GPU CLOCK: requires mhz650, full bringup and memory test\n");
+		return true;
+	}
+	uint32_t old_cfg = reg_read(gcc_va, GCC_GFX3D_CFG_RCGR);
+	uint32_t ctl = reg_read(gcc_va, GCC_GFX_PWRSWITCH_CTRL);
+	uint32_t status = reg_read(gcc_va, GCC_GFX_PWRSWITCH_STATUS);
+	printf("DAISY GPU CLOCK: request650 CFG=%#x BHS=%#x/%#x GPLL3=%#x\n",
+	    old_cfg, ctl, status, reg_read(gcc_va, DG_PLL_MODE));
+	/* BHS under GDSC, LDO under SW and powered down, no fake ACK/CPR bypass. */
+	if ((ctl & 0x400003b7u) != 0x30u || !(status & 2u) ||
+	    (old_cfg & 0x371fu) != 0x507u ||
+	    (reg_read(gcc_va, GCC_GFX3D_CMD_RCGR) & 0x80000003u) != 2u ||
+	    !(reg_read(gcc_va, GCC_OXILI_CX_GDSCR) & GDSC_PWR_ON) ||
+	    !(reg_read(gcc_va, GCC_OXILI_GX_GDSCR) & GDSC_PWR_ON)) {
+		printf("DAISY GPU CLOCK: handoff rejected; keeping startup clock\n");
+		return true;
+	}
+	vm_offset_t acc = ml_io_map(DG_MEM_ACC_PA, 0x1000);
+	if (!acc || daisy_gpu_cx_turbo() != 0) {
+		printf("DAISY GPU CLOCK: power prerequisite failed; keeping startup clock\n");
+		return true;
+	}
+	/* Corner 2 is bit0=0. Raise voltage before selecting faster SRAM timing. */
+	reg_write(acc, DG_MEM_ACC_OFF, reg_read(acc, DG_MEM_ACC_OFF) & ~1u);
+	if ((reg_read(acc, DG_MEM_ACC_OFF) & 1u) ||
+	    (reg_read(gcc_va, GCC_GFX_PWRSWITCH_CTRL) & 0x400003b7u) != 0x30u ||
+	    !(reg_read(gcc_va, GCC_GFX_PWRSWITCH_STATUS) & 2u) || !dg_pll_start()) {
+		printf("DAISY GPU CLOCK: power/PLL check failed; keeping startup clock\n");
+		return true;
+	}
+	if (!dg_rcg_set((old_cfg & ~DG_RCG_MASK) | DG_RCG_650) || !dg_pll_matches()) {
+		bool restored = dg_rcg_set(old_cfg);
+		printf("DAISY GPU CLOCK: switch failed; startup clock restored=%u\n", restored);
+		/* An unacknowledged rollback stops bringup before any CP/GPU service. */
+		return restored;
+	}
+	printf("DAISY GPU CLOCK: configured 650 MHz, CX TURBO ACK, BHS ACK, mem-acc2; "
+	    "GPLL3=%#x L=%u alpha=%#x/%#x CFG=%#x\n",
+	    reg_read(gcc_va, DG_PLL_MODE), reg_read(gcc_va, DG_PLL_L),
+	    reg_read(gcc_va, DG_PLL_ALPHA_HI), reg_read(gcc_va, DG_PLL_ALPHA),
+	    reg_read(gcc_va, GCC_GFX3D_CFG_RCGR));
+	return true;
+}
