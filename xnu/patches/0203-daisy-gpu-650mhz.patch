-	    0x6e657773, 4, 1, 0x00007675, 4, uv};
+	uint32_t packet[] = {52, 0, 0, 0, 0, DR_REQ, 44, id, 0, resource, number, 24,
+	    0x6e657773, 4, 1, key, 4, value};
