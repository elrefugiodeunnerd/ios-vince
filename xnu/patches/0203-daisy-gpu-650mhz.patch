@@ -332,7 +344,8 @@ dr_vote(unsigned ldo, uint32_t uv)
 				dr_signal();
 				int r = dr_ack(answer, bytes, id);
 				if (r <= 0) {
-					printf("DAISY RPM: L%u uv%u id%u r%d ack %x/%x/%x\n", ldo, uv, id, r,
+					printf("DAISY RPM: resource%x/%u key%x value%u id%u r%d ack %x/%x/%x\n",
+					    resource, number, key, value, id, r,
 					    answer[0], answer[1], answer[2]);
 					return r;
 				}
@@ -344,6 +357,27 @@ dr_vote(unsigned ldo, uint32_t uv)
