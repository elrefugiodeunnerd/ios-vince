 }
 
+static int
+dr_vote(unsigned ldo, uint32_t uv)
+{
+	if (!((ldo == 10 && uv == 2850000) || (ldo == 6 && uv == 1800000))) { return -9; }
+	return dr_request(0x616f646c, ldo, 0x00007675, uv);
+}
+
+int
+daisy_gpu_cx_turbo(void)
+{
+	if (dr_gpu_attempted) { return dr_gpu_result; }
+	dr_gpu_attempted = true;
+	dr_gpu_result = dr_open();
+	if (!dr_gpu_result) {
+		/* smpa2 is PM8953 S2/CX; vlvl is a firmware level, not microvolts. */
+		dr_gpu_result = dr_request(0x61706d73, 2, 0x6c766c76, 384);
+	}
+	printf("DAISY RPM: GPU CX TURBO level384 result %d\n", dr_gpu_result);
+	return dr_gpu_result;
+}
