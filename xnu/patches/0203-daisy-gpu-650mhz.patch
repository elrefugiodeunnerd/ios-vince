 static bool dr_attempted;
+static bool dr_opened, dr_gpu_attempted;
+static int dr_gpu_result = -1;
 static unsigned dr_layout_stage;
 
 static uint32_t
@@ -217,6 +223,12 @@ daisy_touch_rpm_layout(void)
