+/* One 24-bit pixel between two others, f of the way (0..65535) from a to b. */
+static inline uint32_t
+fb_mix24(uint32_t a, uint32_t b, uint32_t f)
+{
+	uint32_t out = 0;
+	for (unsigned shift = 0; shift < 24; shift += 8) {
+		uint32_t ca = (a >> shift) & 0xff, cb = (b >> shift) & 0xff;
+		out |= ((ca * (65536 - f) + cb * f + 32768) >> 16) << shift;
+	}
+	return out;
+}
+
+/*
+ * The settle redraw (fb_filter=2): the same picture through a bilinear filter, on the presenter thread while
+ * nothing new arrives. The bars stay black; the four pixels around each panel pixel's centre are blended in
+ * both axes and packed as the nearest path packs them.
+ */
+void
+AppleCLCD::flushPanelBilinear(void)
+{
+	if (!fScaled) {
+		flushPanel();           /* no scaling: the nearest sample is the picture */
+		return;
+	}
+	IOLockLock(fPanelLock);
+	uint32_t barBytes = fBarX * 3, endBytes = (fBarX + fOutW) * 3;
+	for (uint32_t y = 0; y < fHeight; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(fPanel + (uint64_t)y * fPanelRowBytes);
+		uint32_t i;
+		for (i = 0; i < barBytes / 4; i++) {
+			row[i] = 0;
+		}
+		for (i = endBytes / 4; i < fWidth * 3 / 4; i++) {
+			row[i] = 0;
+		}
+		volatile uint32_t *d = row + barBytes / 4;
+		uint32_t syF = (uint32_t)(((2ull * y + 1) * fShadowH << 15) / fHeight);
+		uint32_t y0 = syF >> 16, fy = syF & 0xffff;
+		uint32_t y1 = y0 + 1 < fShadowH ? y0 + 1 : y0;
+		const uint32_t *rowA = (const uint32_t *)(fPixels + (uint64_t)y0 * fRowBytes);
+		const uint32_t *rowB = (const uint32_t *)(fPixels + (uint64_t)y1 * fRowBytes);
+		for (uint32_t x = 0; x + 4 <= fOutW; x += 4, d += 3) {
+			uint32_t p[4];
+			for (unsigned k = 0; k < 4; k++) {
+				uint32_t sxF = (uint32_t)(((2ull * (x + k) + 1) * fShadowW << 15) / fOutW);
+				uint32_t x0 = sxF >> 16, fx = sxF & 0xffff;
+				uint32_t x1 = x0 + 1 < fShadowW ? x0 + 1 : x0;
+				p[k] = fb_mix24(fb_mix24(rowA[x0], rowA[x1], fx), fb_mix24(rowB[x0], rowB[x1], fx), fy);
+			}
+			d[0] = p[0] | p[1] << 24;
+			d[1] = p[1] >> 8 | p[2] << 16;
+			d[2] = p[2] >> 16 | p[3] << 8;
+		}
+	}
+	IOLockUnlock(fPanelLock);
 }
