+/* The vsync timer hands the latest swap to the presenter thread. */
 void
 AppleCLCD::present(const uint8_t *rec)
+{
+	IOLockLock(fPresentLock);
+	memcpy(fWorkRec, rec, SWEET_FB_SWAP_REC_SIZE);
+	fWork = true;
+	IOLockUnlock(fPresentLock);
+	IOLockWakeup(fPresentLock, &fWork, true);
+}
