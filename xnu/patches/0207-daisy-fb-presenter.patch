+/*
+ * The presenter (hakios cd8fdbb): draw the latest swap at fb_pri; when fb_filter=2 and no frame has come for
+ * SWEET_FB_SETTLE_MS, draw the last one again bilinear. Nearest hides the dropped columns and rows while the
+ * picture moves; what stands still on the panel is the filtered one.
+ */
+void
+AppleCLCD::presenterMain(void *self, wait_result_t result)
+{
+	(void)result;
+	((AppleCLCD *)self)->presenter();
+	thread_terminate(current_thread());
+}
+
+void
+AppleCLCD::presenter(void)
+{
+	static uint32_t settled;
+	uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+
+	for (;;) {
+		bool redraw = false;
+		IOLockLock(fPresentLock);
+		while (!fWork) {
+			if (fSettling) {
+				uint64_t deadline;
+				clock_interval_to_deadline(SWEET_FB_SETTLE_MS, NSEC_PER_MSEC, &deadline);
+				if (IOLockSleepDeadline(fPresentLock, &fWork, deadline, THREAD_UNINT) == THREAD_TIMED_OUT && !fWork) {
+					redraw = true;
+					break;
+				}
+				continue;
+			}
+			IOLockSleep(fPresentLock, &fWork, THREAD_UNINT);
+		}
+		if (redraw) {
+			fSettling = false;
+			IOLockUnlock(fPresentLock);
+			memcpy(rec, fLastRec, SWEET_FB_SWAP_REC_SIZE);
+			if (settled++ < 4) {
+				IOLog("SWEET FB: settled redraw %u\n", settled);
+			}
+			drawFrame(rec, true);
+			continue;
+		}
+		memcpy(rec, fWorkRec, SWEET_FB_SWAP_REC_SIZE);
+		memcpy(fLastRec, rec, SWEET_FB_SWAP_REC_SIZE);
+		fWork = false;
+		IOLockUnlock(fPresentLock);
+		drawFrame(rec, fFilter == 1);
+		fSettling = fFilter == 2;
+	}
+}
